#!/usr/bin/env bash
#MISE description="Internal: build, then deploy"
#MISE hide=true
set -euo pipefail

if [ "$#" -gt 1 ]; then
  echo "usage: mise dev -- [kernel]" >&2
  exit 2
fi

selection=${1:-${CUDA_KERNEL:-}}
mise run build

if [ -n "$selection" ]; then
  mise run deploy -- "$selection"
else
  mise run deploy
fi
