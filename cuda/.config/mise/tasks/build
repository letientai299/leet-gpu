#!/usr/bin/env bash
#MISE description="Configure cmake if needed, then build into ./bin"
set -euo pipefail

# Remote targets build in Docker.
TARGET=${SSH_HOST:-local}
if [ ! -e /.dockerenv ] && [ "$TARGET" != local ] && \
  [ "$TARGET" != localhost ]; then
  : "${CONTAINER_NAME:?not set — copy .env.example to .env}"
  if ! docker exec "$CONTAINER_NAME" true 2>/dev/null; then
    echo "container not running; start it with: mise run dc:up" >&2
    exit 1
  fi
  exec docker exec "$CONTAINER_NAME" bash /app/.config/mise/tasks/build
fi

if [ -e /.dockerenv ]; then
  ROOT=/app
else
  ROOT=${MISE_PROJECT_ROOT:-$PWD}
fi

BUILD_DIR=$ROOT/build

# Persist ccache between builds.
export CCACHE_DIR=$ROOT/.ccache

# Ninja can't reuse a build tree configured with a different generator, so drop
# a stale Make tree left over from before we switched.
if [ -f "$BUILD_DIR/CMakeCache.txt" ] && ! grep -q '^CMAKE_GENERATOR:INTERNAL=Ninja' "$BUILD_DIR/CMakeCache.txt"; then
  rm -rf "$BUILD_DIR"
fi

# Configure only when the build tree doesn't exist yet. We deliberately do NOT
# guard on "CMakeLists.txt newer than the cache": a no-op reconfigure doesn't
# rewrite CMakeCache.txt, so its mtime never catches up and the check stays true
# forever once CMakeLists.txt is edited — reconfiguring on every build. Instead
# `cmake --build` drives Ninja, whose generated cmake_check_build_system rule
# re-runs CMake automatically, and only when a real CMake input actually changed.
if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
  cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_RUNTIME_OUTPUT_DIRECTORY="$ROOT/bin"
fi

cmake --build "$BUILD_DIR" --parallel
