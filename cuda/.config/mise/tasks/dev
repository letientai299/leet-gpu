#!/usr/bin/env bash
#MISE description="Watch, rebuild, then deploy on target changes"
set -euo pipefail

TARGET=${SSH_HOST:-local}
if [ "$TARGET" != local ] && [ "$TARGET" != localhost ]; then
  mise run dc:up
fi

# One watcher on the sources. We can't watch bin/main directly: the build
# writes it from inside the container through the bind mount, and Docker Desktop
# for macOS does not propagate those filesystem events back to host watchers.
# So each source change runs dev-step.
exec watchexec --project-origin . --watch src --watch CMakeLists.txt --watch .env --restart -- mise run dev-step
