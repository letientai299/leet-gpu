#!/usr/bin/env bash
#MISE description="Watch sources, rebuild in the container, then deploy+run on GPU host when the binary changes"
set -euo pipefail

mise run dc:up

# One watcher on the sources. We can't watch bin/main directly: the build
# writes it from inside the container through the bind mount, and Docker Desktop
# for macOS does not propagate those filesystem events back to host watchers.
# So each source change runs dev-step, which builds and then deploys only when
# the binary actually changed.
exec watchexec --project-origin . --watch src --watch CMakeLists.txt --restart -- mise run dev-step
