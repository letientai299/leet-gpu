#!/usr/bin/env bash
#MISE description="Smoke-test the in-container clangd LSP against src/hello.cu"
set -euo pipefail

root=${MISE_PROJECT_ROOT:-$PWD}

: "${CONTAINER_NAME:?not set — copy .env.example to .env}"
if ! docker exec "$CONTAINER_NAME" true 2>/dev/null; then
  echo "container not running; start it with: mise run dc:up" >&2
  exit 1
fi

exec python3 "$root/tools/lsp_features.py" "$root"
