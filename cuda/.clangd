# Two jobs:
# 1. Root marker: pins the LSP root to this dir (cuda/), so nvim finds
#    .nvim/clangd here instead of climbing to the parent repo's .git.
# 2. CUDA flags for the container-side clangd (see .nvim/clangd). These let a
#    lone .cu index correctly without a build/compile_commands.json. Paths are
#    container paths. When build/compile_commands.json exists, clangd uses it
#    and merges these on top.
# https://clangd.llvm.org/config#compileflags
CompileFlags:
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_80 # A100, matches CMAKE_CUDA_ARCHITECTURES
    - --no-cuda-version-check
  # build/compile_commands.json drives nvcc; strip its nvcc-only flags that
  # clang(d) rejects. --cuda-gpu-arch above stands in for --generate-code.
  # Trailing * is a clangd glob. Add more here as nvcc flags appear in the build.
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - --options-file*
