#!/usr/bin/env bash
#MISE description="Fix and format C++/CUDA and CMake"
#USAGE arg "[files]" var=#true
set -euo pipefail

if [ "$#" -gt 0 ]; then
  cpp_files=()
  cmake_files=()
  for file in "$@"; do
    case "$file" in
      *.cu | *.cuh | *.cpp | *.cc | *.h | *.hpp) cpp_files+=("$file") ;;
      CMakeLists.txt | */CMakeLists.txt | *.cmake) cmake_files+=("$file") ;;
      *)
        echo "Unsupported format path: $file" >&2
        exit 2
        ;;
    esac
  done

  if [ "${#cpp_files[@]}" -gt 0 ]; then
    mise run lint -- --fix "${cpp_files[@]}"
    clang-format -i "${cpp_files[@]}"
    mise run lint -- "${cpp_files[@]}"
  fi
  if [ "${#cmake_files[@]}" -gt 0 ]; then
    gersemi --config .config/gersemi/config.yaml -i "${cmake_files[@]}"
  fi
  exit
fi

mise run lint -- --fix
find src -type f \
  \( -name '*.cu' -o -name '*.cuh' -o -name '*.cpp' -o -name '*.cc' -o -name '*.h' -o -name '*.hpp' \) \
  -exec clang-format -i {} +
find . -type d \( -name build -o -name 'cmake-build-*' \) -prune \
  -o -name CMakeLists.txt -exec gersemi --config .config/gersemi/config.yaml -i {} +
gersemi --config .config/gersemi/config.yaml -i src/cmake/*.cmake
mise run lint
