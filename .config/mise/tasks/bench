#!/usr/bin/env bash
#MISE description="Benchmark one app with GPU state checks"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/app.sh
source "$task_dir/../lib/app.sh"

gpu=${BENCH_GPU:-0}
clock=${BENCH_CLOCK:-off}
clock_fraction=${BENCH_CLOCK_FRACTION:-85}
idle_watts=${BENCH_IDLE_WATTS:-120}
idle_temp=${BENCH_IDLE_TEMP:-45}
idle_timeout=${BENCH_IDLE_TIMEOUT:-180}

app=${APP:-}
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi
app=$(normalize_app "$app")
binary=bin/$app
if [ ! -x "$binary" ]; then
  echo "app not built: $app" >&2
  exit 1
fi
for arg in "$@"; do
  case "$arg" in
    --help | -h | --version | --list | -l)
      exec "$binary" "$@"
      ;;
  esac
done

target=${SSH_HOST:-local}
if [ "$target" != local ] && [ "$target" != localhost ]; then
  echo "bench: run on the GPU host: $target" >&2
  exit 2
fi
for value in "$clock_fraction" "$idle_watts" "$idle_temp" "$idle_timeout"; do
  if [[ ! "$value" =~ ^(0|[1-9][0-9]{0,5})$ ]]; then
    echo "bench: invalid numeric setting: $value" >&2
    exit 2
  fi
done
if ((clock_fraction == 0 || clock_fraction > 100)); then
  echo "bench: clock fraction requires 1..100" >&2
  exit 2
fi
if [[ "$clock" != off && "$clock" != auto && ! "$clock" =~ ^[1-9][0-9]{0,5}$ ]]; then
  echo "bench: invalid clock: $clock" >&2
  exit 2
fi

query() {
  nvidia-smi -i "$gpu" --query-gpu="$1" --format=csv,noheader,nounits \
    | sed 's/^ *//; s/ *$//'
}

# UUIDs avoid CUDA and NVML ordinal differences.
gpu=$(query uuid)
if [[ ! "$gpu" =~ ^GPU-[a-fA-F0-9-]+$ ]]; then
  echo "bench: select one physical GPU" >&2
  exit 2
fi
lock_dir=${MISE_PROJECT_ROOT:-$PWD}/.ai/benchmark-harness/locks
mkdir -p "$lock_dir"
exec 9>"$lock_dir/$gpu.lock"
if ! flock -n 9; then
  echo "bench: GPU already benchmarked: $gpu" >&2
  exit 1
fi

gpu_admin() {
  nvidia-smi -i "$gpu" "$@" >/dev/null 2>&1 \
    || sudo -n nvidia-smi -i "$gpu" "$@" >/dev/null 2>&1
}

locked=0
persistence_restore=
child=
restore_clock=${BENCH_RESTORE_CLOCK:-}
restore() {
  local status=$?
  trap - EXIT INT TERM
  if [ "$locked" = 1 ]; then
    local restored=0
    if [ "$restore_clock" = off ]; then
      gpu_admin -rgc && restored=1
    else
      gpu_admin -lgc "$restore_clock" && restored=1
    fi
    if [ "$restored" = 0 ]; then
      echo "bench: clock restoration failed: $gpu" >&2
      status=1
    fi
  fi
  if [ -n "$persistence_restore" ]; then
    if ! gpu_admin -pm "$persistence_restore"; then
      echo "bench: persistence restoration failed: $gpu" >&2
      status=1
    fi
  fi
  exit "$status"
}
interrupt() {
  local status=$1
  trap '' INT TERM
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || true
    wait "$child" || true
  fi
  exit "$status"
}
trap restore EXIT
trap 'interrupt 130' INT
trap 'interrupt 143' TERM

processes=$(nvidia-smi -i "$gpu" --query-compute-apps=pid --format=csv,noheader)
if [ -n "$processes" ] && [ "${BENCH_FORCE:-0}" != 1 ]; then
  echo "bench: GPU busy; BENCH_FORCE=1 overrides: $gpu" >&2
  exit 1
fi

if [ "$clock" != off ]; then
  # NVML cannot query the previous locked range.
  if [[ "$restore_clock" != off && ! "$restore_clock" =~ ^[1-9][0-9]{0,5}(,[1-9][0-9]{0,5})?$ ]]; then
    echo "bench: set BENCH_RESTORE_CLOCK=off or prior MHz range" >&2
    exit 2
  fi
  max_clock=$(query clocks.max.sm)
  if [[ ! "$max_clock" =~ ^[1-9][0-9]{0,5}$ ]]; then
    echo "bench: maximum SM clock unavailable" >&2
    exit 1
  fi
  if [ "$clock" = auto ]; then
    target_clock=$((max_clock * clock_fraction / 100))
    clock=$(nvidia-smi -i "$gpu" --query-supported-clocks=gr --format=csv,noheader,nounits \
      | awk -v t="$target_clock" '$1 ~ /^[0-9]+$/ && $1 <= t && $1 > best {best=$1} END {print best}')
    if [ -z "$clock" ]; then
      echo "bench: supported SM clocks unavailable" >&2
      exit 1
    fi
  fi
  previous_persistence=$(query persistence_mode)
  if [ "$previous_persistence" = Disabled ]; then
    persistence_restore=0
    if ! gpu_admin -pm 1; then
      echo "bench: persistence change failed: $gpu" >&2
      exit 1
    fi
  fi
  locked=1
  if ! gpu_admin -lgc "$clock,$clock"; then
    echo "bench: clock lock failed: $gpu" >&2
    exit 1
  fi
  echo "bench: $gpu locked to ${clock}MHz" >&2
  has_threshold=0
  for arg in "$@"; do
    case "$arg" in
      --throttle-threshold | --throttle-threshold=*) has_threshold=1 ;;
    esac
  done
  if [ "$has_threshold" = 0 ]; then
    threshold=$((clock * 100 / max_clock - 2))
    ((threshold >= 0)) || threshold=0
    set -- "$@" --throttle-threshold "$threshold"
  fi
fi

deadline=$((SECONDS + idle_timeout))
while true; do
  watts=$(query power.draw)
  temp=$(query temperature.gpu)
  if [[ ! "$watts" =~ ^[0-9]+([.][0-9]+)?$ || ! "$temp" =~ ^[0-9]+$ ]]; then
    echo "bench: power or temperature telemetry unavailable" >&2
    exit 1
  fi
  if ((${watts%%.*} <= idle_watts && temp <= idle_temp)); then
    break
  fi
  if ((SECONDS >= deadline)); then
    echo "bench: cooldown timed out: ${watts}W/${temp}C" >&2
    [ "${BENCH_ALLOW_HOT:-0}" = 1 ] || exit 1
    break
  fi
  sleep 1
done

echo "bench: $(query name) UUID=$gpu driver=$(query driver_version)" >&2
echo "bench: temp=${temp}C power=${watts}W cap=$(query power.limit)W" >&2
echo "bench: SM=$(query clocks.sm)MHz memory=$(query clocks.mem)MHz" >&2
printf 'bench: command:' >&2
printf ' %q' "$binary" "$@" >&2
printf '\n' >&2
sha256sum "$binary" >&2
export CUDA_VISIBLE_DEVICES=$gpu
"$binary" "$@" &
child=$!
wait "$child"
