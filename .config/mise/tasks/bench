#!/usr/bin/env bash
#MISE description="Benchmark one app with GPU state checks"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/app.sh
source "$task_dir/../lib/app.sh"
# shellcheck source=.config/mise/lib/gpu.sh
source "$task_dir/../lib/gpu.sh"

gpu=${BENCH_GPU:-0}
clock=${BENCH_CLOCK:-auto}
clock_fraction=${BENCH_CLOCK_FRACTION:-85}
idle_watts=${BENCH_IDLE_WATTS:-120}
idle_temp=${BENCH_IDLE_TEMP:-45}
idle_timeout=${BENCH_IDLE_TIMEOUT:-180}

app=${APP:-}
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi
app=$(normalize_app "$app")
binary=bin/$app
if [ ! -x "$binary" ]; then
  echo "app not built: $app" >&2
  exit 1
fi
for arg in "$@"; do
  case "$arg" in
    --help | -h | --version | --list | -l)
      exec "$binary" "$@"
      ;;
  esac
done

target=${SSH_HOST:-local}
if [ "$target" != local ] && [ "$target" != localhost ]; then
  echo "bench: run on the GPU host: $target" >&2
  exit 2
fi
for value in "$clock_fraction" "$idle_watts" "$idle_temp" "$idle_timeout"; do
  if [[ ! "$value" =~ ^(0|[1-9][0-9]{0,5})$ ]]; then
    echo "bench: invalid numeric setting: $value" >&2
    exit 2
  fi
done
if ((clock_fraction == 0 || clock_fraction > 100)); then
  echo "bench: clock fraction requires 1..100" >&2
  exit 2
fi
if [[ "$clock" != off && "$clock" != auto && ! "$clock" =~ ^[1-9][0-9]{0,5}$ ]]; then
  echo "bench: invalid clock: $clock" >&2
  exit 2
fi

query() {
  gpu_query "$gpu" "$1"
}

# UUIDs avoid CUDA and NVML ordinal differences.
gpu=$(query uuid)
if [[ ! "$gpu" =~ ^GPU-[a-fA-F0-9-]+$ ]]; then
  echo "bench: select one physical GPU" >&2
  exit 2
fi
# Shares deploy's per-GPU lock; bench refuses instead of waiting.
gpu_open_lock "$gpu"
if ! flock -n 9; then
  echo "bench: GPU already benchmarked: $gpu" >&2
  exit 1
fi

locked=0
persistence_restore=
child=
# NVML cannot query a prior locked range; off resets to the driver default.
restore_clock=${BENCH_RESTORE_CLOCK:-off}
restore() {
  local status=$?
  trap - EXIT INT TERM
  if [ "$locked" = 1 ]; then
    local restored=0
    if [ "$restore_clock" = off ]; then
      gpu_admin "$gpu" -rgc && restored=1
    else
      gpu_admin "$gpu" -lgc "$restore_clock" && restored=1
    fi
    if [ "$restored" = 0 ]; then
      echo "bench: clock restoration failed: $gpu" >&2
      status=1
    fi
  fi
  if [ -n "$persistence_restore" ]; then
    if ! gpu_admin "$gpu" -pm "$persistence_restore"; then
      echo "bench: persistence restoration failed: $gpu" >&2
      status=1
    fi
  fi
  exit "$status"
}
interrupt() {
  local status=$1
  trap '' INT TERM
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || true
    wait "$child" || true
  fi
  exit "$status"
}
trap restore EXIT
trap 'interrupt 130' INT
trap 'interrupt 143' TERM

processes=$(nvidia-smi -i "$gpu" --query-compute-apps=pid --format=csv,noheader)
if [ -n "$processes" ] && [ "${BENCH_FORCE:-0}" != 1 ]; then
  echo "bench: GPU busy; BENCH_FORCE=1 overrides: $gpu" >&2
  exit 1
fi

request=$clock
if [ "$clock" != off ]; then
  if [[ "$restore_clock" != off && ! "$restore_clock" =~ ^[1-9][0-9]{0,5}(,[1-9][0-9]{0,5})?$ ]]; then
    echo "bench: BENCH_RESTORE_CLOCK needs off or a MHz range" >&2
    exit 2
  fi
  max_clock=$(query clocks.max.sm)
  # Locking needs root; without it, warn and measure at whatever clock runs.
  if [ "$(query persistence_mode)" = Disabled ] && gpu_admin "$gpu" -pm 1; then
    persistence_restore=0
  fi
  if clock=$(gpu_pick_clock "$gpu" "$clock" "$clock_fraction" "$max_clock") \
    && { [ "$request" != auto ] || clock=$(gpu_cap_clock "$gpu" "$clock"); } \
    && gpu_admin "$gpu" -lgc "$clock,$clock"; then
    locked=1
    export LG_LOCKED_CLOCK_MHZ=$clock
    echo "bench: $gpu locked to ${clock}MHz" >&2
    has_threshold=0
    for arg in "$@"; do
      case "$arg" in
        --throttle-threshold | --throttle-threshold=*) has_threshold=1 ;;
      esac
    done
    if [ "$has_threshold" = 0 ] && [[ "$max_clock" =~ ^[1-9][0-9]{0,5}$ ]]; then
      set -- "$@" --throttle-threshold "$(gpu_throttle_threshold "$clock" "$max_clock")"
    fi
  else
    echo "bench: clock lock failed; running unlocked: $gpu" >&2
  fi
fi

deadline=$((SECONDS + idle_timeout))
while true; do
  watts=$(query power.draw)
  temp=$(query temperature.gpu)
  if [[ ! "$watts" =~ ^[0-9]+([.][0-9]+)?$ || ! "$temp" =~ ^[0-9]+$ ]]; then
    echo "bench: power or temperature telemetry unavailable" >&2
    exit 1
  fi
  if ((${watts%%.*} <= idle_watts && temp <= idle_temp)); then
    break
  fi
  if ((SECONDS >= deadline)); then
    echo "bench: cooldown timed out: ${watts}W/${temp}C" >&2
    [ "${BENCH_ALLOW_HOT:-0}" = 1 ] || exit 1
    break
  fi
  sleep 1
done

if [ "$request" != off ]; then
  gpu_check_health "$gpu"
fi

echo "bench: $(query name) UUID=$gpu driver=$(query driver_version)" >&2
echo "bench: temp=${temp}C power=${watts}W cap=$(query power.limit)W" >&2
echo "bench: SM=$(query clocks.sm)MHz memory=$(query clocks.mem)MHz" >&2
printf 'bench: command:' >&2
printf ' %q' "$binary" "$@" >&2
printf '\n' >&2
sha256sum "$binary" >&2
export CUDA_VISIBLE_DEVICES=$gpu
if [ "$locked" = 1 ]; then
  mark=$(gpu_power_mark "$gpu")
fi
"$binary" "$@" &
child=$!
status=0
wait "$child" || status=$?
child=
if [ "$locked" = 1 ] && [ "$request" = auto ]; then
  gpu_review_power "$gpu" "$gpu" "$clock" "$max_clock" "$mark"
fi
# restore (EXIT trap) reports this status.
(exit "$status")
