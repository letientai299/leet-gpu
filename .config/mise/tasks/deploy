#!/usr/bin/env bash
#MISE description="Deploy and run one app on the GPU target"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/app.sh
source "$task_dir/../lib/app.sh"

target=${SSH_HOST:-local}
app=${APP:-}

if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi
app=$(normalize_app "$app")

args=("$@")
if [ "${#args[@]}" -eq 0 ] && [ -n "${ARGS:-}" ]; then
  # ARGS is trusted project-local shell input.
  eval "args=($ARGS)"
fi

binary=bin/$app
if [ ! -x "$binary" ]; then
  echo "app not built: $app" >&2
  exit 1
fi

if [ "$target" = local ] || [ "$target" = localhost ]; then
  if [ "${#args[@]}" -eq 0 ]; then
    exec "$binary"
  fi
  exec "$binary" "${args[@]}"
fi

: "${CONTAINER_NAME:?not set — copy .env.example to .env}"

remote=$target
remote_name=${app//\//-}
remote_bin=/tmp/${CONTAINER_NAME}-${remote_name}

# Reuse one multiplexed SSH connection across the rsync + run round trips and
# across dev-loop iterations, so the connection/auth handshake is paid once
# instead of on every deploy. ControlPersist keeps the master warm between edits.
ssh_opts=(-o ControlMaster=auto -o ControlPath="/tmp/ssh-${CONTAINER_NAME}-%r@%h" -o ControlPersist=1h)

# Prefer a modern rsync (3.2+) over macOS's bundled openrsync at /usr/bin/rsync:
# with 3.2+ on both ends, -z negotiates zstd (much better/faster than zlib) and
# still falls back gracefully to an older remote. brew installs it outside the
# default PATH order, so resolve it explicitly.
rsync_bin=$(command -v rsync)
for candidate in /opt/homebrew/bin/rsync /usr/local/bin/rsync; do
  [ -x "$candidate" ] && { rsync_bin=$candidate; break; }
done

# rsync sends only the changed blocks of the recompiled binary (delta, against
# the previous copy at $REMOTE_BIN) and -z compresses them — far less than the
# ~1 MB a fresh scp pushes every time. --inplace rewrites the changed blocks
# directly into the remote file instead of building a full temp copy and
# renaming it, which matters more as the binary grows; --partial keeps a
# half-sent file around so an interrupted transfer resumes as a delta baseline.
"$rsync_bin" -z --inplace --partial -e "ssh ${ssh_opts[*]}" "$binary" \
  "$remote:$remote_bin"

if [ "${#args[@]}" -eq 0 ]; then
  printf -v remote_command '%q ' "$remote_bin"
else
  printf -v remote_command '%q ' "$remote_bin" "${args[@]}"
fi

# The command is shell-escaped before crossing the SSH boundary.
# shellcheck disable=SC2029
ssh "${ssh_opts[@]}" "$remote" "$remote_command"
