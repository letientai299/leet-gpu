#!/usr/bin/env bash
#MISE description="Deploy and run one app on the GPU target"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/app.sh
source "$task_dir/../lib/app.sh"
# shellcheck source=.config/mise/lib/target.sh
source "$task_dir/../lib/target.sh"

target=${SSH_HOST:-local}
app=${APP:-}

if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi
app=$(normalize_app "$app")

args=("$@")
if [ "${#args[@]}" -eq 0 ] && [ -n "${ARGS:-}" ]; then
  # ARGS is trusted project-local shell input.
  eval "args=($ARGS)"
fi

# Entropy stops about 10x sooner than stdrel with the same median; bench
# keeps stdrel. NVBench rejects a criterion that follows its parameters, so it
# goes right after --bench, and any explicit criterion flag opts out.
has_bench=0
has_criterion=0
for arg in "${args[@]+"${args[@]}"}"; do
  case "$arg" in
    --bench) has_bench=1 ;;
    --stopping-criterion* | --max-noise* | --min-time* | --max-angle* | --min-r2*)
      has_criterion=1
      ;;
  esac
done
if [ "$has_bench" = 1 ] && [ "$has_criterion" = 0 ]; then
  with_criterion=()
  for arg in "${args[@]}"; do
    with_criterion+=("$arg")
    if [ "$arg" = --bench ]; then
      with_criterion+=(--stopping-criterion entropy)
    fi
  done
  args=("${with_criterion[@]}")
fi

binary=bin/$app
if [ ! -x "$binary" ]; then
  echo "app not built: $app" >&2
  exit 1
fi

# Every run waits for the GPU (gpu.sh holds a per-GPU host lock), and --bench
# runs lock the SM clock. A lone run unlocks afterward. A dev session
# (CLOCK_SESSION) keeps the lock, records its key, and unlocks the old target
# when the key changes; dev unlocks the last one on exit.
clock=off
if [ "$has_bench" = 1 ]; then
  clock=${GPU_CLOCK:-auto}
fi
keep=0
if [ -n "${CLOCK_SESSION:-}" ] && [ "$has_bench" = 1 ]; then
  key=
  if [ "$clock" != off ]; then
    keep=1
    key=$(clock_key "$target")
  fi
  held=$(cat "$CLOCK_SESSION" 2>/dev/null || true)
  if [ -n "$held" ] && [ "$held" != "$key" ]; then
    clock_unlock "$held" || true
  fi
  # Recorded before locking, so an interrupt cannot leak the lock.
  printf '%s\n' "$key" >"$CLOCK_SESSION"
fi
gpu_args=(run "${GPU_INDEX:-0}" "$clock" "${GPU_CLOCK_FRACTION:-85}" "$keep" --)

if is_local_target "$target"; then
  run_gpu "$target" "${gpu_args[@]}" "$binary" "${args[@]+"${args[@]}"}"
  exit
fi

: "${CONTAINER_NAME:?not set — copy .env.example to .env}"

remote=$target
remote_name=${app//\//-}
remote_bin=/tmp/${CONTAINER_NAME}-${remote_name}

# Prefer a modern rsync (3.2+) over macOS's bundled openrsync at /usr/bin/rsync:
# with 3.2+ on both ends, -z negotiates zstd (much better/faster than zlib) and
# still falls back gracefully to an older remote. brew installs it outside the
# default PATH order, so resolve it explicitly.
rsync_bin=$(command -v rsync)
for candidate in /opt/homebrew/bin/rsync /usr/local/bin/rsync; do
  [ -x "$candidate" ] && {
    rsync_bin=$candidate
    break
  }
done

# rsync sends only the changed blocks of the recompiled binary (delta, against
# the previous copy at $REMOTE_BIN) and -z compresses them — far less than the
# ~1 MB a fresh scp pushes every time. --inplace rewrites the changed blocks
# directly into the remote file instead of building a full temp copy and
# renaming it, which matters more as the binary grows; --partial keeps a
# half-sent file around so an interrupted transfer resumes as a delta baseline.
"$rsync_bin" -z --inplace --partial -e "ssh ${ssh_opts[*]}" "$binary" \
  "$remote:$remote_bin"

run_gpu "$target" "${gpu_args[@]}" "$remote_bin" "${args[@]+"${args[@]}"}"
