#!/usr/bin/env bash
#MISE description="Compare two kernels in one NVBench JSON run"
#USAGE arg "<run.json>" help="NVBench --jsonbin output"
#USAGE arg "[baseline]" help="Benchmark name to treat as reference"
#USAGE arg "[candidate]" help="Benchmark name to compare against it"
set -euo pipefail

run=${1:-}
if [ -z "$run" ] || [ ! -f "$run" ]; then
  echo "usage: mise run bench-compare <run.json> [baseline] [candidate]" >&2
  exit 2
fi
shift
if [ "$#" -gt 2 ]; then
  echo "too many benchmark names" >&2
  exit 2
fi

names=()
name_list=$(jq -er '.benchmarks | arrays | .[].name' "$run")
while IFS= read -r name; do
  names+=("$name")
done <<<"$name_list"

baseline=${1:-${names[0]:-}}
candidate=${2:-${names[1]:-}}
if [ -z "$baseline" ] || [ -z "$candidate" ] || [ "$baseline" = "$candidate" ]; then
  echo "need two distinct benchmark names; found: ${names[*]-none}" >&2
  exit 2
fi

# nvbench-compare-robust pairs benchmarks by name, so two differently named
# kernels never match. Rename both to a common name in two split files.
# Keep the splits beside the source: bulk sample paths inside the JSON are
# relative to its directory.
run_dir=$(cd -- "$(dirname -- "$run")" && pwd -P)
ref=
cmp=
trap 'rm -f -- "${ref:-}" "${cmp:-}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
ref=$(mktemp "$run_dir/.compare-ref.XXXXXX.json")
cmp=$(mktemp "$run_dir/.compare-cmp.XXXXXX.json")

select_one() {
  jq -e --arg want "$1" \
    '.benchmarks |= [.[] | select(.name == $want) | .name = "comparison"] |
     if (.benchmarks | length) != 1 then error("benchmark name missing or ambiguous")
     elif (.benchmarks[0].states | length) == 0 then error("benchmark states missing")
     elif any(.benchmarks[0].states[]; .is_skipped == true) then error("benchmark state skipped")
     else . end' \
    "$run" >"$2"
}
select_one "$baseline" "$ref"
select_one "$candidate" "$cmp"

echo "baseline=$baseline candidate=$candidate"

# The compare tools are Python entry points of the vendored nvbench wheel, not
# build targets. uv supplies their dependencies without installing anything.
# https://github.com/NVIDIA/nvbench/blob/main/docs/nvbench_compare_robust.md
script=.cache/fetchcontent/nvbench-src/python/scripts/nvbench_compare_robust.py
if [ ! -f "$script" ]; then
  echo "nvbench sources missing; run mise build first" >&2
  exit 1
fi

uv run --no-project --quiet --with numpy --with tabulate \
  python "$script" --no-color --display explain "$ref" "$cmp"
