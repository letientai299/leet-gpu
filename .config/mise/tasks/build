#!/usr/bin/env bash
#MISE description="Build all apps or one app into ./bin"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/app.sh
source "$task_dir/../lib/app.sh"

if [ "$#" -gt 1 ]; then
  echo "usage: mise build -- [app]" >&2
  exit 2
fi

app=$(normalize_app "${1:-}")

# A toolkit install puts nvcc under its own prefix, not on the default PATH, so
# CMake needs CUDACXX to detect the CUDA compiler.
# https://cmake.org/cmake/help/latest/envvar/CUDACXX.html
find_nvcc() {
  local candidate prefix
  local -a versioned=()

  for candidate in "${CUDACXX:-}" "$(command -v nvcc || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  for prefix in "${CUDA_HOME:-}" "${CUDA_PATH:-}" /usr/local/cuda /opt/cuda; do
    [ -n "$prefix" ] || continue
    candidate=$prefix/bin/nvcc
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  # Versioned prefixes stay behind when /usr/local/cuda is missing. Newest wins.
  shopt -s nullglob
  versioned=(/usr/local/cuda-*/bin/nvcc /opt/cuda-*/bin/nvcc)
  shopt -u nullglob
  [ "${#versioned[@]}" -gt 0 ] || return 1

  while read -r candidate; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(printf '%s\n' "${versioned[@]}" | sort -Vr)
  return 1
}

if [ -e /.dockerenv ]; then
  root=/app
  flavor=docker
else
  root=${MISE_PROJECT_ROOT:-$PWD}
  nvcc_bin=$(find_nvcc || true)
  build_env=${BUILD_ENV:-auto}
  if [ "$build_env" = auto ]; then
    if [ -n "$nvcc_bin" ]; then
      build_env=local
    else
      build_env=docker
    fi
  fi

  case "$build_env" in
    local)
      flavor=local
      if [ -z "$nvcc_bin" ]; then
        echo "nvcc not found; install the CUDA toolkit, set CUDACXX, or use BUILD_ENV=docker" >&2
        exit 1
      fi
      export CUDACXX=$nvcc_bin
      PATH=$(dirname "$nvcc_bin"):$PATH
      export PATH
      ;;
    docker)
      : "${CONTAINER_NAME:?not set — copy .env.example to .env}"
      project_root=$(cd "$root" && pwd -P)
      mount_source=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/app"}}{{.Source}}{{end}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || true)
      if ! docker exec "$CONTAINER_NAME" true 2>/dev/null || [ "$mount_source" != "$project_root" ]; then
        mise run dc:up
      fi
      exec docker exec "$CONTAINER_NAME" bash /app/.config/mise/tasks/build ${app:+"$app"}
      ;;
    *)
      echo "invalid BUILD_ENV: $build_env" >&2
      exit 2
      ;;
  esac
fi

# Old layout was a single CMake tree at build/.
if [ -f "$root/build/CMakeCache.txt" ] \
  && [ ! -d "$root/build/docker" ] \
  && [ ! -d "$root/build/local" ]; then
  rm -rf "$root/build"
fi

build_dir=$root/build/$flavor
export CCACHE_DIR=$build_dir/ccache
export CCACHE_BASEDIR=$root

if command -v nproc >/dev/null; then
  jobs=$(nproc)
elif command -v sysctl >/dev/null; then
  jobs=$(sysctl -n hw.ncpu)
else
  jobs=8
fi
export CMAKE_BUILD_PARALLEL_LEVEL=$jobs

if [ -f "$build_dir/CMakeCache.txt" ] \
  && ! grep -q '^CMAKE_GENERATOR:INTERNAL=Ninja' "$build_dir/CMakeCache.txt"; then
  rm -rf "$build_dir"
fi

# A failed nvcc probe caches CMAKE_CUDA_COMPILER-NOTFOUND and keeps failing.
if [ -f "$build_dir/CMakeCache.txt" ] \
  && grep -q '^CMAKE_CUDA_COMPILER:.*NOTFOUND' "$build_dir/CMakeCache.txt"; then
  rm -rf "$build_dir"
fi

if [ ! -f "$build_dir/CMakeCache.txt" ]; then
  cmake -S "$root" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}"
fi

if [ -z "$app" ]; then
  cmake --build "$build_dir" --parallel "$jobs"
  exit
fi

cmake --build "$build_dir" --parallel "$jobs" --target "$(app_target "$app")"
