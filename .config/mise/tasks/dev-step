#!/usr/bin/env bash
#MISE description="Internal: build, then deploy"
#MISE hide=true
set -euo pipefail

app=${APP:-}
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi

mise run build -- "$app"
mise run deploy -- "$app" "$@"
