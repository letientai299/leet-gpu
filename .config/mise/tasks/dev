#!/usr/bin/env bash
#MISE description="Watch, rebuild, then deploy one app with a locked GPU clock"
set -euo pipefail

task_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=.config/mise/lib/target.sh
source "$task_dir/../lib/target.sh"

app=
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ] && [ -z "${APP:-}" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi

watch_args=(--watch src --watch CMakeLists.txt)
if [ -f .env ]; then
  watch_args+=(--watch .env)
fi

# Leave APP unresolved here so each iteration re-reads it from .env.
run_args=(mise run try --)
if [ -n "$app" ]; then
  run_args+=("$app")
fi
run_args+=("$@")

# deploy records the lock it holds here and swaps it when .env retargets;
# see the session format in deploy.
CLOCK_SESSION=$(mktemp "${TMPDIR:-/tmp}/lg-clock.XXXXXX")
export CLOCK_SESSION
release_clock() {
  local held
  held=$(cat "$CLOCK_SESSION" 2>/dev/null || true)
  if [ -n "$held" ]; then
    clock_unlock "$held" || true
  fi
  rm -f "$CLOCK_SESSION"
}
trap release_clock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

watchexec -I --project-origin . "${watch_args[@]}" --restart -- "${run_args[@]}"
