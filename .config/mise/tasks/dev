#!/usr/bin/env bash
#MISE description="Watch, rebuild, then deploy one app"
set -euo pipefail

app=
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  app=$1
  shift
fi
if [ -z "$app" ] && [ -z "${APP:-}" ]; then
  echo "app missing; pass one or set APP" >&2
  exit 2
fi

watch_args=(--watch apps --watch libs --watch cmake --watch CMakeLists.txt)
if [ -f .env ]; then
  watch_args+=(--watch .env)
fi

# Leave APP unresolved here so each iteration re-reads it from .env.
run_args=(mise run dev-step --)
if [ -n "$app" ]; then
  run_args+=("$app")
fi
run_args+=("$@")

exec watchexec -I --project-origin . "${watch_args[@]}" --restart -- "${run_args[@]}"
