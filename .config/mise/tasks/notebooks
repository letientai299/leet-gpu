#!/usr/bin/env bash
#MISE description="Run JupyterLab with Vim bindings"
#MISE alias="nb"
#MISE raw=true
set -euo pipefail

cd "$MISE_PROJECT_ROOT"
export JUPYTERLAB_SETTINGS_DIR="$PWD/.config/jupyter/lab/user-settings"
export JUPYTERLAB_WORKSPACES_DIR="$PWD/.cache/jupyter/lab/workspaces"
export JUPYTER_CONFIG_PATH="$PWD/.config/jupyter${JUPYTER_CONFIG_PATH:+:$JUPYTER_CONFIG_PATH}"

uv run --project src/notebooks --locked python .config/jupyter/configure.py

offset=0
if [ "$(git branch --show-current)" != "main" ]; then
  hash=$(basename "$PWD" | tr -d '\n' | cksum | cut -d ' ' -f 1)
  offset=$(((hash % 100) * 10))
fi

server_pid=
stop_server() {
  trap - EXIT
  trap '' HUP INT TERM
  if [ -n "$server_pid" ]; then
    kill -TERM "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  exit "$1"
}
trap 'stop_server "$?"' EXIT
trap 'stop_server 130' INT
trap 'stop_server 143' TERM

# Handle HUP through the supervisor.
trap '' HUP
src/notebooks/.venv/bin/python -m jupyterlab \
  --ServerApp.root_dir="$PWD/src/notebooks" \
  --ServerApp.ip=127.0.0.1 \
  --ServerApp.port="${NOTEBOOK_PORT:-$((8888 + offset))}" "$@" <&0 &
server_pid=$!
trap 'stop_server 129' HUP
status=0
wait "$server_pid" || status=$?
server_pid=
stop_server "$status"
