# Local env + agent scratch
.env
.ai.dump/
tmp/

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/
*.ipynb
.ipynb_checkpoints/

# Local notebook playground
/src/notebooks/**
!/src/notebooks/**/
!/src/notebooks/.python-version
!/src/notebooks/jupytext.toml
!/src/notebooks/pyproject.toml
!/src/notebooks/uv.lock

# JupyterLab preferences
.config/jupyter/lab/user-settings/**
!.config/jupyter/lab/user-settings/**/
!.config/jupyter/lab/user-settings/@axlair/jupyterlab_vim/plugin.jupyterlab-settings
!.config/jupyter/lab/user-settings/@jupyterlab/docmanager-extension/plugin.jupyterlab-settings

# OS / editor / LSP cruft
.DS_Store
*.swp
!.nvim.lua
# A global ignore drops .idea/; re-include it to track the shared CMake profile.
!.idea/
.idea/*
!.idea/cmake.xml
# clangd writes its index to .cache/clangd
.cache/

*.log

# CUDA build output
build/
bin/
cmake-build-*/
.ccache/

.codex/
compile_commands.json
